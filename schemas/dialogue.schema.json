{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storybound/dialogue.schema.json",
  "title": "Storybound dialogue",
  "description": "data/<namespace>/storybound/dialogues/<path>.json — a node graph run by the server; the client sees one line or choice at a time.",
  "type": "object",
  "required": ["start", "nodes"],
  "additionalProperties": false,
  "properties": {
    "participants": {
      "description": "Who may speak besides 'player'. Default: { \"npc\": { \"type\": \"bound\" } }.",
      "type": "object",
      "propertyNames": { "not": { "const": "player" } },
      "additionalProperties": { "$ref": "#/definitions/participant" }
    },
    "start": { "description": "The first node.", "type": "string" },
    "nodes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/node" }
    },
    "presentation": {
      "description": "screen: a blocking dialogue screen. hud: subtitles, the player keeps moving (a choice still opens the screen).",
      "enum": ["screen", "hud"],
      "default": "screen"
    },
    "closable": { "description": "ESC leaves the dialogue (on_abort runs).", "type": "boolean", "default": true },
    "broadcast": { "description": "Nearby players see the lines as speech bubbles.", "type": "boolean", "default": true },
    "on_abort": {
      "description": "Run when the dialogue is interrupted: ESC, walking away, damage, the NPC gone, logging out.",
      "$ref": "logic.schema.json#/definitions/actions"
    },
    "camera": {
      "description": "auto: shot-reverse-shot on the dialogue screen, when the server config and the player allow it. off: the player's own view.",
      "enum": ["auto", "off"],
      "default": "auto"
    }
  },
  "definitions": {
    "target": {
      "description": "A node id, @end (ends this dialogue; inside a call returns to the caller) or @exit (ends the whole conversation).",
      "type": "string"
    },
    "participant": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "bound: the entity the dialogue was started with. virtual: no entity (a narrator).",
          "enum": ["bound", "virtual"]
        },
        "name": { "description": "Overrides the entity's name; needed for virtual speakers.", "$ref": "logic.schema.json#/definitions/story_text" },
        "portrait": { "description": "A texture for a virtual speaker, e.g. mypack:textures/portrait/narrator.png.", "$ref": "logic.schema.json#/definitions/id" }
      }
    },
    "option": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "id": { "description": "Defaults to the option's position; keep it stable for 'once'.", "type": "string" },
        "text": { "$ref": "logic.schema.json#/definitions/story_text" },
        "conditions": { "$ref": "logic.schema.json#/definitions/conditions" },
        "locked": {
          "description": "When the conditions fail: hide the option, or show it greyed out.",
          "enum": ["hide", "show"],
          "default": "hide"
        },
        "locked_text": { "description": "The hint on a greyed-out option.", "$ref": "logic.schema.json#/definitions/story_text" },
        "once": { "description": "Hidden for this player after being chosen once.", "type": "boolean", "default": false },
        "actions": {
          "description": "Run when chosen; if they abort (a price could not be taken), the choice is shown again.",
          "$ref": "logic.schema.json#/definitions/actions"
        },
        "next": { "$ref": "#/definitions/target", "default": "@end" },
        "think": {
          "description": "Seconds the NPC thinks (animated dots) before answering; 0 for none. By default 1.5-4 s from the length of the option's text.",
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "description": "A spoken line; with duration (seconds) it also moves on by itself.",
          "properties": {
            "type": { "const": "line" },
            "speaker": { "description": "'player' or a participant id.", "type": "string" },
            "text": { "$ref": "logic.schema.json#/definitions/story_text" },
            "next": { "$ref": "#/definitions/target", "default": "@end" },
            "sound": { "description": "Played with the line, e.g. a voice clip from a resource pack.", "$ref": "logic.schema.json#/definitions/id" },
            "duration": { "type": "number", "minimum": 0.1, "maximum": 600 },
            "shot": {
              "description": "The camera for this line. auto: over the listener's shoulder at the speaker. two_shot: both from the side. close_up: the speaker's face. first_person: no camera movement.",
              "enum": ["auto", "two_shot", "close_up", "first_person"],
              "default": "auto"
            },
            "transition": {
              "description": "From the previous shot: cut, or ease (a short glide).",
              "enum": ["cut", "ease"],
              "default": "cut"
            }
          },
          "required": ["speaker", "text"],
          "additionalProperties": false
        },
        {
          "description": "The player picks an option; with a timeout, waiting too long goes to timeout.next.",
          "properties": {
            "type": { "const": "choice" },
            "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/option" } },
            "timeout": {
              "type": "object",
              "required": ["seconds", "next"],
              "additionalProperties": false,
              "properties": {
                "seconds": { "type": "number", "minimum": 1, "maximum": 600 },
                "next": { "$ref": "#/definitions/target" }
              }
            }
          },
          "required": ["options"],
          "additionalProperties": false
        },
        {
          "description": "Branches without showing anything.",
          "properties": {
            "type": { "const": "condition" },
            "conditions": { "$ref": "logic.schema.json#/definitions/conditions" },
            "then": { "$ref": "#/definitions/target" },
            "else": { "$ref": "#/definitions/target" }
          },
          "required": ["conditions", "then", "else"],
          "additionalProperties": false
        },
        {
          "description": "Runs actions, then moves on. An aborted list interrupts the dialogue.",
          "properties": {
            "type": { "const": "action" },
            "actions": { "$ref": "logic.schema.json#/definitions/actions" },
            "next": { "$ref": "#/definitions/target", "default": "@end" },
            "on_fail": { "enum": ["abort", "continue"], "default": "abort" }
          },
          "required": ["actions"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "random" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["next"],
                "additionalProperties": false,
                "properties": {
                  "weight": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1 },
                  "next": { "$ref": "#/definitions/target" }
                }
              }
            }
          },
          "required": ["options"],
          "additionalProperties": false
        },
        {
          "description": "Continues at a node, or at another dialogue (its start unless node is given), without returning.",
          "properties": {
            "type": { "const": "jump" },
            "node": { "type": "string" },
            "dialogue": { "$ref": "logic.schema.json#/definitions/id" }
          },
          "anyOf": [ { "required": ["node"] }, { "required": ["dialogue"] } ],
          "additionalProperties": false
        },
        {
          "description": "Runs another dialogue; when it ends, continues at next.",
          "properties": {
            "type": { "const": "call" },
            "dialogue": { "$ref": "logic.schema.json#/definitions/id" },
            "node": { "type": "string" },
            "next": { "$ref": "#/definitions/target", "default": "@end" }
          },
          "required": ["dialogue"],
          "additionalProperties": false
        },
        {
          "description": "Ends the dialogue after running its actions.",
          "properties": {
            "type": { "const": "end" },
            "actions": { "$ref": "logic.schema.json#/definitions/actions" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
