{
  "participants": {
    "elder": { "type": "bound", "name": "example.npc.elder" }
  },
  "start": "greet",
  "nodes": {
    "greet": {
      "type": "condition",
      "conditions": { "type": "flag", "key": "example:met_elder" },
      "then": "welcome_back",
      "else": "first_meeting"
    },
    "first_meeting": { "type": "line", "speaker": "elder", "text": "example.dialogue.elder.first_meeting", "next": "introduce" },
    "introduce": { "type": "line", "speaker": "player", "text": "example.dialogue.elder.introduce", "next": "hand_letter" },
    "hand_letter": {
      "type": "action",
      "actions": [
        { "type": "set_flag", "key": "example:met_elder" },
        { "type": "give_document", "document": "example:elder_letter" },
        { "type": "play_sound", "sound": "minecraft:entity.villager.yes" },
        { "type": "add_waypoint", "id": "example:elder", "name": "example.npc.elder", "follow": true, "visibility": "party", "color": "#E8C66A" }
      ],
      "next": "letter"
    },
    "letter": { "type": "line", "speaker": "elder", "text": "example.dialogue.elder.letter", "next": "topics" },
    "welcome_back": {
      "type": "line",
      "speaker": "elder",
      "text": { "key": "example.dialogue.elder.welcome_back", "args": ["{player}"] },
      "next": "topics"
    },
    "topics": {
      "type": "choice",
      "options": [
        {
          "id": "wolves",
          "text": "example.dialogue.elder.ask_wolves",
          "conditions": { "type": "not", "condition": { "type": "quest", "quest": "example:wolf_hunt", "state": "completed" } },
          "next": "wolves"
        },
        {
          "id": "report",
          "text": "example.dialogue.elder.report",
          "conditions": { "type": "quest", "quest": "example:wolf_hunt", "stage": "report" },
          "next": "reported"
        },
        {
          "id": "gift",
          "text": "example.dialogue.elder.gift",
          "conditions": { "type": "has_item", "item": "minecraft:bread", "count": 3 },
          "locked": "show",
          "locked_text": "example.dialogue.elder.gift_locked",
          "once": true,
          "actions": [
            { "type": "take_item", "item": "minecraft:bread", "count": 3 },
            { "type": "add_var", "key": "example:village_reputation", "amount": 5 }
          ],
          "next": "thanks"
        },
        { "id": "bye", "text": "example.dialogue.elder.bye", "next": "farewell" }
      ]
    },
    "wolves": { "type": "random", "options": [ { "next": "wolves_pack" }, { "next": "wolves_white" } ] },
    "wolves_pack": { "type": "line", "speaker": "elder", "text": "example.dialogue.elder.wolves_pack", "next": "topics" },
    "wolves_white": { "type": "line", "speaker": "elder", "text": "example.dialogue.elder.wolves_white", "next": "topics" },
    "reported": { "type": "line", "speaker": "elder", "text": "example.dialogue.elder.reported", "next": "@end" },
    "thanks": { "type": "line", "speaker": "elder", "text": "example.dialogue.elder.thanks", "next": "topics" },
    "farewell": { "type": "line", "speaker": "elder", "text": "example.dialogue.elder.farewell", "duration": 3, "next": "@end" }
  }
}
