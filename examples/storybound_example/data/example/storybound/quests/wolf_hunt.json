{
  "category": "contract",
  "scope": "party",
  "title": "example.quest.wolf_hunt.title",
  "text": {
    "active": "example.quest.wolf_hunt.active",
    "completed": "example.quest.wolf_hunt.completed"
  },
  "start": {
    "trigger": { "type": "document_read", "document": "example:elder_letter" }
  },
  "stages": [
    {
      "id": "hunt",
      "log": "example.quest.wolf_hunt.log.hunt",
      "objectives": [
        {
          "id": "wolves",
          "trigger": { "type": "entity_killed", "entity": "minecraft:wolf" },
          "count": 3,
          "text": "example.quest.wolf_hunt.objective.wolves"
        },
        {
          "id": "oath",
          "trigger": { "type": "document_read", "document": "example:hunters_oath" },
          "text": "example.quest.wolf_hunt.objective.oath",
          "optional": true
        }
      ],
      "on_enter": { "type": "give_document", "document": "example:hunters_oath" }
    },
    {
      "id": "report",
      "log": "example.quest.wolf_hunt.log.report",
      "objectives": [
        {
          "trigger": { "type": "entity_interacted", "entity": "minecraft:villager" },
          "text": "example.quest.wolf_hunt.objective.report"
        }
      ]
    }
  ],
  "on_complete": { "type": "add_var", "key": "example:village_reputation", "amount": 10 },
  "rewards": [
    { "type": "give_item", "item": "minecraft:emerald", "count": 5 },
    { "type": "play_sound", "sound": "minecraft:entity.player.levelup" }
  ]
}
